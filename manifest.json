{
  "manifest_version": 3,
  "default_locale": "de",
  "name": "__MSG_extensionName__",
  "version": "0.20.8",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "32": "icons/manga-regal.svg",
    "48": "icons/manga-regal.svg",
    "64": "icons/manga-regal.svg",
    "96": "icons/manga-regal.svg"
  },
  "permissions": [
    "activeTab",
    "bookmarks",
    "search",
    "scripting",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/manga-regal.svg",
      "32": "icons/manga-regal.svg",
      "48": "icons/manga-regal.svg",
      "64": "icons/manga-regal.svg"
    }
  },
  "background": {
    "scripts": [
      "shared/platform.js",
      "shared/store.js",
      "shared/sync.js",
      "background/background.js"
    ]
  },
  "commands": {
    "toggle-manga-regal": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "__MSG_commandDescription__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "manga-regal@local.example",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "bookmarksInfo",
          "browsingActivity",
          "technicalAndInteraction",
          "websiteActivity",
          "websiteContent"
        ]
      }
    }
  }
}
